from ...domain.entities.auth_tokens import AuthTokens
from ...domain.exceptions import InvalidTokenError, RefreshTokenReuseError
from ...domain.interfaces.refresh_token_repository import RefreshTokenRepository
from ...domain.interfaces.token_hasher import TokenHasher
from .issue_auth_tokens import IssueAuthTokens


class RefreshAuthTokens:
    """Rotates refresh tokens. Reuse of a revoked token revokes the whole family.

    >>> # RefreshAuthTokens(...).execute(raw_refresh)  # doctest: +SKIP
    """

    def __init__(
        self,
        hasher: TokenHasher,
        refresh_tokens: RefreshTokenRepository,
        issuer: IssueAuthTokens,
    ) -> None:
        self._hasher = hasher
        self._refresh_tokens = refresh_tokens
        self._issuer = issuer

    {% if async_mode == "async" %}async {% endif %}def execute(self, raw_refresh: str) -> AuthTokens:
        token_hash = self._hasher.hash(raw_refresh)
        stored = {% if async_mode == "async" %}await {% endif %}self._refresh_tokens.get_by_hash(token_hash)
        if stored is None or stored.is_expired():
            raise InvalidTokenError()
        if stored.is_revoked():
            {% if async_mode == "async" %}await {% endif %}self._refresh_tokens.revoke_all_for_user(stored.user_id)
            raise RefreshTokenReuseError()
        issued = {% if async_mode == "async" %}await {% endif %}self._issuer.execute(stored.user_id)
        revoked = stored.revoke(replaced_by_id=issued.refresh_token_id)
        {% if async_mode == "async" %}await {% endif %}self._refresh_tokens.update(revoked)
        return issued
