class UpdateItem:
    """Applies partial updates to an existing item.

    >>> # UpdateItem(repo).execute(item_id, name="New")  # doctest: +SKIP
    """

    def __init__(self, repository: ItemRepository) -> None:
        self._repository = repository

    {% if async_mode == "async" %}async {% endif %}def execute(
        self,
        item_id: UUID,
        name: str | None,
        description: str | None,
    ) -> Item:
        item = {% if async_mode == "async" %}await {% endif %}self._repository.get_by_id(item_id)
        if item is None:
            raise ItemNotFoundError(item_id)
        updated = item.with_updates(name=name, description=description)
        return {% if async_mode == "async" %}await {% endif %}self._repository.update(updated)
