from ...domain.exceptions import EmailAlreadyExistsError
from ...domain.interfaces.password_hasher import PasswordHasher
from ...domain.interfaces.user_repository import UserRepository


class RegisterUser:
    """Creates a user with a hashed password.

    >>> # RegisterUser(users, hasher).execute("a@b.com", "secret")  # doctest: +SKIP
    """

    def __init__(self, users: UserRepository, hasher: PasswordHasher) -> None:
        self._users = users
        self._hasher = hasher

    {% if async_mode == "async" %}async {% endif %}def execute(self, email: str, password: str) -> User:
        existing = {% if async_mode == "async" %}await {% endif %}self._users.get_by_email(email)
        if existing is not None:
            raise EmailAlreadyExistsError(email)
        user = User(
            id=uuid4(),
            email=email,
            hashed_password=self._hasher.hash(password),
        )
        return {% if async_mode == "async" %}await {% endif %}self._users.add(user)
