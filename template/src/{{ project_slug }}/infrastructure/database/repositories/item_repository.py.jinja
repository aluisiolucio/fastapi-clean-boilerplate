from uuid import UUID

{% if async_mode == "async" -%}
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession
{% else -%}
from sqlalchemy import select
from sqlalchemy.orm import Session
{%- endif %}

from ....domain.entities.item import Item
from ..models.item import ItemModel


def _to_entity(model: ItemModel) -> Item:
    return Item(id=model.id, name=model.name, description=model.description)


class SqlAlchemyItemRepository:
    def __init__(self, session: {% if async_mode == "async" %}AsyncSession{% else %}Session{% endif %}) -> None:
        self._session = session

    {% if async_mode == "async" %}async {% endif %}def add(self, item: Item) -> Item:
        model = ItemModel(id=item.id, name=item.name, description=item.description)
        self._session.add(model)
        {% if async_mode == "async" %}await {% endif %}self._session.flush()
        return _to_entity(model)

    {% if async_mode == "async" %}async {% endif %}def get_by_id(self, item_id: UUID) -> Item | None:
        model = {% if async_mode == "async" %}await {% endif %}self._session.get(ItemModel, item_id)
        if model is None:
            return None
        return _to_entity(model)

    {% if async_mode == "async" %}async {% endif %}def list_all(self) -> list[Item]:
        {% if async_mode == "async" -%}
        result = await self._session.scalars(select(ItemModel))
        return [_to_entity(model) for model in result.all()]
        {% else -%}
        models = self._session.scalars(select(ItemModel)).all()
        return [_to_entity(model) for model in models]
        {%- endif %}

    {% if async_mode == "async" %}async {% endif %}def update(self, item: Item) -> Item:
        model = {% if async_mode == "async" %}await {% endif %}self._session.get(ItemModel, item.id)
        if model is None:
            return item
        model.name = item.name
        model.description = item.description
        {% if async_mode == "async" %}await {% endif %}self._session.flush()
        return _to_entity(model)

    {% if async_mode == "async" %}async {% endif %}def delete(self, item_id: UUID) -> None:
        model = {% if async_mode == "async" %}await {% endif %}self._session.get(ItemModel, item_id)
        if model is None:
            return
        {% if async_mode == "async" -%}
        await self._session.delete(model)
        await self._session.flush()
        {% else -%}
        self._session.delete(model)
        self._session.flush()
        {%- endif %}
