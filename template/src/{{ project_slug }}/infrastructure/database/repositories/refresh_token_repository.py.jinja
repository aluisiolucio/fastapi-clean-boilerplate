from datetime import UTC, datetime
from uuid import UUID

from sqlalchemy import select, update
{% if async_mode == "async" -%}
from sqlalchemy.ext.asyncio import AsyncSession
{%- else -%}
from sqlalchemy.orm import Session
{%- endif %}

from ....domain.entities.refresh_token import RefreshToken
from ..models.refresh_token import RefreshTokenModel


def _to_entity(model: RefreshTokenModel) -> RefreshToken:
    return RefreshToken(
        id=model.id,
        user_id=model.user_id,
        token_hash=model.token_hash,
        expires_at=model.expires_at,
        revoked_at=model.revoked_at,
        replaced_by_id=model.replaced_by_id,
    )


def _apply(model: RefreshTokenModel, token: RefreshToken) -> None:
    model.user_id = token.user_id
    model.token_hash = token.token_hash
    model.expires_at = token.expires_at
    model.revoked_at = token.revoked_at
    model.replaced_by_id = token.replaced_by_id


class SqlAlchemyRefreshTokenRepository:
    def __init__(self, session: {% if async_mode == "async" %}AsyncSession{% else %}Session{% endif %}) -> None:
        self._session = session

    {% if async_mode == "async" %}async {% endif %}def add(self, token: RefreshToken) -> RefreshToken:
        model = RefreshTokenModel(
            id=token.id,
            user_id=token.user_id,
            token_hash=token.token_hash,
            expires_at=token.expires_at,
            revoked_at=token.revoked_at,
            replaced_by_id=token.replaced_by_id,
        )
        self._session.add(model)
        {% if async_mode == "async" %}await {% endif %}self._session.flush()
        return _to_entity(model)

    {% if async_mode == "async" %}async {% endif %}def get_by_hash(self, token_hash: str) -> RefreshToken | None:
        stmt = select(RefreshTokenModel).where(
            RefreshTokenModel.token_hash == token_hash
        )
        {% if async_mode == "async" -%}
        result = await self._session.scalars(stmt)
        model = result.first()
        {%- else -%}
        model = self._session.scalars(stmt).first()
        {%- endif %}
        if model is None:
            return None
        return _to_entity(model)

    {% if async_mode == "async" %}async {% endif %}def update(self, token: RefreshToken) -> RefreshToken:
        model = {% if async_mode == "async" %}await {% endif %}self._session.get(RefreshTokenModel, token.id)
        if model is None:
            return token
        _apply(model, token)
        {% if async_mode == "async" %}await {% endif %}self._session.flush()
        return _to_entity(model)

    {% if async_mode == "async" %}async {% endif %}def revoke_all_for_user(self, user_id: UUID) -> None:
        stmt = (
            update(RefreshTokenModel)
            .where(
                RefreshTokenModel.user_id == user_id,
                RefreshTokenModel.revoked_at.is_(None),
            )
            .values(revoked_at=datetime.now(UTC))
        )
        {% if async_mode == "async" %}await {% endif %}self._session.execute(stmt)
        {% if async_mode == "async" %}await {% endif %}self._session.flush()
