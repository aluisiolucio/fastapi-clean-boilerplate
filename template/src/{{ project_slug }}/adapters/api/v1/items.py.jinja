from typing import Annotated
from uuid import UUID

from fastapi import APIRouter, Depends, Response, status

from ....application.use_cases.create_item import CreateItem
from ....application.use_cases.delete_item import DeleteItem
from ....application.use_cases.get_item import GetItem
from ....application.use_cases.list_items import ListItems
from ....application.use_cases.update_item import UpdateItem
from ....domain.entities.item import Item
from ....domain.entities.user import User
from ..deps import (
    get_create_item,
    get_current_user,
    get_delete_item,
    get_get_item,
    get_list_items,
    get_update_item,
)
from .schemas.item import ItemCreate, ItemResponse, ItemUpdate

router = APIRouter(prefix="/items", tags=["items"])


def _to_response(item: Item) -> ItemResponse:
    return ItemResponse(id=item.id, name=item.name, description=item.description)


@router.post("", response_model=ItemResponse, status_code=201)
{% if async_mode == "async" %}async {% endif %}def create_item(
    payload: ItemCreate,
    _user: Annotated[User, Depends(get_current_user)],
    use_case: Annotated[CreateItem, Depends(get_create_item)],
) -> ItemResponse:
    item = {% if async_mode == "async" %}await {% endif %}use_case.execute(payload.name, payload.description)
    return _to_response(item)


@router.get("", response_model=list[ItemResponse])
{% if async_mode == "async" %}async {% endif %}def list_items(
    _user: Annotated[User, Depends(get_current_user)],
    use_case: Annotated[ListItems, Depends(get_list_items)],
) -> list[ItemResponse]:
    items = {% if async_mode == "async" %}await {% endif %}use_case.execute()
    return [_to_response(item) for item in items]


@router.get("/{item_id}", response_model=ItemResponse)
{% if async_mode == "async" %}async {% endif %}def get_item(
    item_id: UUID,
    _user: Annotated[User, Depends(get_current_user)],
    use_case: Annotated[GetItem, Depends(get_get_item)],
) -> ItemResponse:
    item = {% if async_mode == "async" %}await {% endif %}use_case.execute(item_id)
    return _to_response(item)


@router.patch("/{item_id}", response_model=ItemResponse)
{% if async_mode == "async" %}async {% endif %}def update_item(
    item_id: UUID,
    payload: ItemUpdate,
    _user: Annotated[User, Depends(get_current_user)],
    use_case: Annotated[UpdateItem, Depends(get_update_item)],
) -> ItemResponse:
    item = {% if async_mode == "async" %}await {% endif %}use_case.execute(
        item_id,
        payload.name,
        payload.description,
    )
    return _to_response(item)


@router.delete("/{item_id}", status_code=204)
{% if async_mode == "async" %}async {% endif %}def delete_item(
    item_id: UUID,
    _user: Annotated[User, Depends(get_current_user)],
    use_case: Annotated[DeleteItem, Depends(get_delete_item)],
) -> Response:
    {% if async_mode == "async" %}await {% endif %}use_case.execute(item_id)
    return Response(status_code=status.HTTP_204_NO_CONTENT)
