{% set list_class = "List" ~ (resource_plural | title | replace('_', '')) -%}
{% set use_case_imports = [
    ("authenticate_user", "AuthenticateUser"),
    ("get_current_user", "GetCurrentUser"),
    ("issue_auth_tokens", "IssueAuthTokens"),
    ("logout_user", "LogoutUser"),
    ("refresh_auth_tokens", "RefreshAuthTokens"),
    ("register_user", "RegisterUser"),
] -%}
{% if include_crud -%}
{% set _ = use_case_imports.extend([
    ("create_" ~ resource_module, "Create" ~ resource_name),
    ("delete_" ~ resource_module, "Delete" ~ resource_name),
    ("get_" ~ resource_module, "Get" ~ resource_name),
    ("list_" ~ resource_plural, list_class),
    ("update_" ~ resource_module, "Update" ~ resource_name),
]) -%}
{% endif -%}
{% set use_case_import_lines = [] -%}
{% for module, symbol in use_case_imports | sort -%}
{% set line = 'from ...application.use_cases.' ~ module ~ ' import ' ~ symbol -%}
{% if (line | length) <= 88 -%}
{% set _ = use_case_import_lines.append(line) -%}
{% else -%}
{% set _ = use_case_import_lines.extend([
    'from ...application.use_cases.' ~ module ~ ' import (',
    '    ' ~ symbol ~ ',',
    ')',
]) -%}
{% endif -%}
{% endfor -%}
{% set repository_imports = [
    ("refresh_token_repository", "SqlAlchemyRefreshTokenRepository"),
    ("user_repository", "SqlAlchemyUserRepository"),
] -%}
{% if include_crud -%}
{% set _ = repository_imports.append(
    (resource_module ~ "_repository", "SqlAlchemy" ~ resource_name ~ "Repository")
) -%}
{% endif -%}
{% set repository_import_lines = [] -%}
{% for module, symbol in repository_imports | sort -%}
{% set line = 'from ...infrastructure.database.repositories.' ~ module ~ ' import ' ~ symbol -%}
{% if (line | length) <= 88 -%}
{% set _ = repository_import_lines.append(line) -%}
{% else -%}
{% set _ = repository_import_lines.extend([
    'from ...infrastructure.database.repositories.' ~ module ~ ' import (',
    '    ' ~ symbol ~ ',',
    ')',
]) -%}
{% endif -%}
{% endfor -%}
{% set resource_repository_def = 'def get_' ~ resource_module ~ '_repository(session: SessionDep) -> SqlAlchemy' ~ resource_name ~ 'Repository:' -%}
{% if (resource_repository_def | length) <= 88 -%}
{% set resource_repository_getter = resource_repository_def ~ '\n    return SqlAlchemy' ~ resource_name ~ 'Repository(session)' -%}
{% else -%}
{% set resource_repository_getter = 'def get_' ~ resource_module ~ '_repository(\n    session: SessionDep,\n) -> SqlAlchemy' ~ resource_name ~ 'Repository:\n    return SqlAlchemy' ~ resource_name ~ 'Repository(session)' -%}
{% endif -%}
{% set crud_getters = [] -%}
{% if include_crud -%}
{% set crud_specs = [
    ("create", "Create" ~ resource_name),
    ("get", "Get" ~ resource_name),
    ("list", list_class),
    ("update", "Update" ~ resource_name),
    ("delete", "Delete" ~ resource_name),
] -%}
{% for kind, class_name in crud_specs -%}
{% set getter_name = 'get_' ~ kind ~ '_' ~ (resource_plural if kind == 'list' else resource_module) -%}
{% set _ = crud_getters.append(
    'def ' ~ getter_name ~ '(\n'
    ~ '    repositories: Annotated[\n'
    ~ '        SqlAlchemy' ~ resource_name ~ 'Repository,\n'
    ~ '        Depends(get_' ~ resource_module ~ '_repository),\n'
    ~ '    ],\n'
    ~ ') -> ' ~ class_name ~ ':\n'
    ~ '    return ' ~ class_name ~ '(repositories)'
) -%}
{% endfor -%}
{% endif -%}
{% set crud_block = crud_getters | join('\n\n\n') -%}
from typing import Annotated

from fastapi import Depends
from fastapi.security import OAuth2PasswordBearer
{% if async_mode == "async" -%}
from sqlalchemy.ext.asyncio import AsyncSession
{%- else -%}
from sqlalchemy.orm import Session
{%- endif %}

{{ use_case_import_lines | join('\n') }}
from ...domain.entities.user import User
from ...infrastructure.auth.jwt_token_service import JwtTokenService
from ...infrastructure.auth.pwdlib_hasher import PwdlibPasswordHasher
from ...infrastructure.auth.refresh_token_generator import SecureRefreshTokenGenerator
from ...infrastructure.auth.sha256_token_hasher import Sha256TokenHasher
from ...infrastructure.config.settings import Settings, get_settings
{{ repository_import_lines | join('\n') }}
from ...infrastructure.database.session import get_session

oauth2_scheme = OAuth2PasswordBearer(tokenUrl="/api/v1/auth/token")

SessionDep = Annotated[{% if async_mode == "async" %}AsyncSession{% else %}Session{% endif %}, Depends(get_session)]
SettingsDep = Annotated[Settings, Depends(get_settings)]


def _hasher() -> PwdlibPasswordHasher:
    return PwdlibPasswordHasher()


def _token_hasher() -> Sha256TokenHasher:
    return Sha256TokenHasher()


def get_user_repository(session: SessionDep) -> SqlAlchemyUserRepository:
    return SqlAlchemyUserRepository(session){{ ('\n\n\n' ~ resource_repository_getter) if include_crud else '' }}


def get_refresh_token_repository(
    session: SessionDep,
) -> SqlAlchemyRefreshTokenRepository:
    return SqlAlchemyRefreshTokenRepository(session)


def get_token_service(settings: SettingsDep) -> JwtTokenService:
    return JwtTokenService(settings)


def get_refresh_generator(settings: SettingsDep) -> SecureRefreshTokenGenerator:
    return SecureRefreshTokenGenerator(
        expire_days=settings.refresh_token_expire_days,
        hasher=_token_hasher(),
    )


def get_register_user(
    users: Annotated[SqlAlchemyUserRepository, Depends(get_user_repository)],
) -> RegisterUser:
    return RegisterUser(users, _hasher())


def get_authenticate_user(
    users: Annotated[SqlAlchemyUserRepository, Depends(get_user_repository)],
) -> AuthenticateUser:
    return AuthenticateUser(users, _hasher())


def get_issue_auth_tokens(
    tokens: Annotated[JwtTokenService, Depends(get_token_service)],
    generator: Annotated[SecureRefreshTokenGenerator, Depends(get_refresh_generator)],
    refresh_tokens: Annotated[
        SqlAlchemyRefreshTokenRepository,
        Depends(get_refresh_token_repository),
    ],
    settings: SettingsDep,
) -> IssueAuthTokens:
    return IssueAuthTokens(
        tokens,
        generator,
        refresh_tokens,
        settings.access_token_expire_seconds,
    )


def get_refresh_auth_tokens(
    refresh_tokens: Annotated[
        SqlAlchemyRefreshTokenRepository,
        Depends(get_refresh_token_repository),
    ],
    issuer: Annotated[IssueAuthTokens, Depends(get_issue_auth_tokens)],
) -> RefreshAuthTokens:
    return RefreshAuthTokens(_token_hasher(), refresh_tokens, issuer)


def get_logout_user(
    refresh_tokens: Annotated[
        SqlAlchemyRefreshTokenRepository,
        Depends(get_refresh_token_repository),
    ],
) -> LogoutUser:
    return LogoutUser(_token_hasher(), refresh_tokens)


def get_current_user_use_case(
    users: Annotated[SqlAlchemyUserRepository, Depends(get_user_repository)],
    tokens: Annotated[JwtTokenService, Depends(get_token_service)],
) -> GetCurrentUser:
    return GetCurrentUser(users, tokens)


{% if async_mode == "async" %}async {% endif %}def get_current_user(
    token: Annotated[str, Depends(oauth2_scheme)],
    use_case: Annotated[GetCurrentUser, Depends(get_current_user_use_case)],
) -> User:
    return {% if async_mode == "async" %}await {% endif %}use_case.execute(token){{ ('\n\n\n' ~ crud_block) if include_crud else '' }}
