{% if include_crud -%}
{% set _ = entity_imports.append((resource_module, resource_name)) -%}
{% endif -%}
{% set entity_import_lines = [] -%}
{% for module, symbol in entity_imports | sort -%}
{% set line = 'from ' ~ project_slug ~ '.domain.entities.' ~ module ~ ' import ' ~ symbol -%}
{% if (line | length) <= 88 -%}
{% set _ = entity_import_lines.append(line) -%}
{% else -%}
{% set _ = entity_import_lines.extend([
    'from ' ~ project_slug ~ '.domain.entities.' ~ module ~ ' import (',
    '    ' ~ symbol ~ ',',
    ')',
