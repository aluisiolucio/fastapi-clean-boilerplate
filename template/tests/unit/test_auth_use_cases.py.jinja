EMAIL = "user@example.com"
PASSWORD = "s3cret-password"


def _issuer() -> tuple[
    IssueAuthTokens, InMemoryRefreshTokenRepository, FakeTokenHasher
]:
    hasher = FakeTokenHasher()
    refresh_tokens = InMemoryRefreshTokenRepository()
    issuer = IssueAuthTokens(
        FakeTokenService(),
        FakeRefreshTokenGenerator(hasher),
        refresh_tokens,
        access_expire_seconds=900,
    )
    return issuer, refresh_tokens, hasher


