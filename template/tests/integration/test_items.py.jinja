PASSWORD = "s3cret-password"


{% if async_mode == "async" %}async {% endif %}def _auth_header(client, email: str) -> dict[str, str]:
    register = {% if async_mode == "async" %}await {% endif %}client.post(
        "/api/v1/auth/register",
        json={"email": email, "password": PASSWORD},
    )
    assert register.status_code == 201
    login = {% if async_mode == "async" %}await {% endif %}client.post(
        "/api/v1/auth/token",
        data={"username": email, "password": PASSWORD},
    )
    token = login.json()["access_token"]
    return {"Authorization": f"Bearer {token}"}


{% if async_mode == "async" %}async {% endif %}def test_items_require_authentication(client) -> None:
    response = {% if async_mode == "async" %}await {% endif %}client.get("/api/v1/items")
    assert response.status_code == 401


{% if async_mode == "async" %}async {% endif %}def test_item_rejects_blank_name(client) -> None:
    headers = {% if async_mode == "async" %}await {% endif %}_auth_header(client, "blank@example.com")
    response = {% if async_mode == "async" %}await {% endif %}client.post(
        "/api/v1/items",
        json={"name": "   ", "description": ""},
        headers=headers,
    )
    assert response.status_code == 422


{% if async_mode == "async" %}async {% endif %}def test_item_crud(client) -> None:
    headers = {% if async_mode == "async" %}await {% endif %}_auth_header(client, "owner@example.com")
    created = {% if async_mode == "async" %}await {% endif %}client.post(
        "/api/v1/items",
        json={"name": "Notebook", "description": "A4"},
        headers=headers,
    )
    assert created.status_code == 201
    item_id = created.json()["id"]
    listed = {% if async_mode == "async" %}await {% endif %}client.get("/api/v1/items", headers=headers)
    assert listed.status_code == 200
    assert len(listed.json()) == 1
    fetched = {% if async_mode == "async" %}await {% endif %}client.get(f"/api/v1/items/{item_id}", headers=headers)
    assert fetched.json()["name"] == "Notebook"
    patched = {% if async_mode == "async" %}await {% endif %}client.patch(
        f"/api/v1/items/{item_id}",
        json={"name": "Sketchbook"},
        headers=headers,
    )
    assert patched.json()["name"] == "Sketchbook"
    assert patched.json()["description"] == "A4"
    deleted = {% if async_mode == "async" %}await {% endif %}client.delete(f"/api/v1/items/{item_id}", headers=headers)
    assert deleted.status_code == 204
    missing = {% if async_mode == "async" %}await {% endif %}client.get(f"/api/v1/items/{item_id}", headers=headers)
    assert missing.status_code == 404
