{% if async_mode == "async" %}async {% endif %}def test_refresh_rotates_and_reuse_is_rejected(client) -> None:
    email = "carol@example.com"
    {% if async_mode == "async" %}await {% endif %}_register(client, email)
    first = {% if async_mode == "async" %}await {% endif %}_login(client, email)
    rotated = {% if async_mode == "async" %}await {% endif %}client.post(
        "/api/v1/auth/refresh",
        json={"refresh_token": first["refresh_token"]},
    )
    assert rotated.status_code == 200
    assert rotated.json()["refresh_token"] != first["refresh_token"]
    reused = {% if async_mode == "async" %}await {% endif %}client.post(
        "/api/v1/auth/refresh",
        json={"refresh_token": first["refresh_token"]},
    )
    assert reused.status_code == 401


{% if async_mode == "async" %}async {% endif %}def test_logout_prevents_refresh(client) -> None:
    email = "dave@example.com"
    {% if async_mode == "async" %}await {% endif %}_register(client, email)
    tokens = {% if async_mode == "async" %}await {% endif %}_login(client, email)
    logout = {% if async_mode == "async" %}await {% endif %}client.post(
        "/api/v1/auth/logout",
        json={"refresh_token": tokens["refresh_token"]},
    )
    assert logout.status_code == 204
    refresh = {% if async_mode == "async" %}await {% endif %}client.post(
        "/api/v1/auth/refresh",
        json={"refresh_token": tokens["refresh_token"]},
    )
    assert refresh.status_code == 401
