PASSWORD = "s3cret-password"


{% if async_mode == "async" %}async {% endif %}def _register(client, email: str) -> None:
    response = {% if async_mode == "async" %}await {% endif %}client.post(
        "/api/v1/auth/register",
        json={"email": email, "password": PASSWORD},
    )
    assert response.status_code == 201


{% if async_mode == "async" %}async {% endif %}def _login(client, email: str) -> dict[str, object]:
    response = {% if async_mode == "async" %}await {% endif %}client.post(
        "/api/v1/auth/token",
        data={"username": email, "password": PASSWORD},
    )
    assert response.status_code == 200
    return response.json()


{% if async_mode == "async" %}async {% endif %}def test_register_login_and_me(client) -> None:
    email = "alice@example.com"
    {% if async_mode == "async" %}await {% endif %}_register(client, email)
    tokens = {% if async_mode == "async" %}await {% endif %}_login(client, email)
    me = {% if async_mode == "async" %}await {% endif %}client.get(
        "/api/v1/auth/me",
        headers={"Authorization": f"Bearer {tokens['access_token']}"},
    )
    assert me.status_code == 200
    assert me.json()["email"] == email


{% if async_mode == "async" %}async {% endif %}def test_register_duplicate_email_conflict(client) -> None:
    email = "dup@example.com"
    {% if async_mode == "async" %}await {% endif %}_register(client, email)
